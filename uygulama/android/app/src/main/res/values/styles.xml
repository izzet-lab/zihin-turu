<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Beyaz şerit sorunu.

        Android 15'ten (targetSdk 35+) itibaren uygulama pencereyi baştan
        sona kaplar; durum çubuğunun arkası artık uygulamanın kendi
        zeminidir. Capacitor, durum çubuğu görünümünü ayarlarken pencere
        arka planını TEMADAN okuyor. Tema açık (Light) olduğu için okunan
        renk beyazdı: ekranın en üstünde, durum çubuğunun arkasında beyaz
        bir şerit kalıyordu.

        Bu yüzden tema koyuya alındı ve pencere arka planı doğrudan oyunun
        zemin rengine sabitlendi. Bu çözüm JS tarafındaki durum çubuğu
        çağrılarının zamanlamasına bağlı değil; uygulama daha ilk karede
        doğru renkte açılır.
    -->
    <color name="zt_arkaplan">#0A0E1A</color>

    <!-- Ana uygulama teması. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/zt_arkaplan</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/zt_arkaplan</item>
        <item name="android:background">@color/zt_arkaplan</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@color/zt_arkaplan</item>
    </style>
</resources>
