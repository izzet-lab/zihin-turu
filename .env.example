# Supabase bağlantısı — her ortam (canlı / test) ayrı değer kullanır.
# Bu dosyayı kopyalayıp .env adıyla kaydet; asla git'e commit etme.
#
# Değerleri Supabase Dashboard > Project Settings > API bölümünden al.
# Service role anahtarı BURAYA GİRMEZ — yalnızca Edge Function'da durur.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AdMob reklam birimi kimligi (Android). Tanimli degilse Google'in
# resmi TEST kimligi kullanilir; gercek reklam gosterilmez.
VITE_ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
