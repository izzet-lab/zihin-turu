<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Giriş dönüşü: com.zihinturu.app://giris -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.zihinturu.app" />
            </intent-filter>
        </activity>

        <!-- AdMob uygulama kimliği (gerçek kimlik, AdMob konsolundan).
             Uygulama kimliğinde tilde (~), reklam birimi kimliğinde
             eğik çizgi (/) bulunur; karıştırılırsa uygulama açılışta
             çöker. Banner birimi kimliği .env dosyasındadır. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6339500340265560~9019003216" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bildirim izni (Android 13+). Kullanıcıya sorulur, reddedilebilir. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
         REKLAM KİMLİĞİ (AAID) — 5 Eylül 2026'da geri kondu.

         Bu izinler daha önce `tools:node="remove"` ile açıkça
         kaldırılmıştı. Gerekçe o zamanki kuraldı: uygulama çocuğa
         yönelik sayılıyordu ve hiç kişiselleştirme yapılmıyordu.

         Ağustos 2026'da kural değişti (CLAUDE.md kural 6): 18 yaş üstü
         kullanıcıya UMP ile onay sorulur ve onay verirse
         kişiselleştirilmiş reklam gösterilir. İzin kaldırılmış haldeyken
         bu mümkün değildi — AdMob reklam kimliğini okuyamadığı için
         onay veren kullanıcıya da kişiselleştirilmemiş reklam gidiyordu.
         Yani onay ekranı olmayan bir seçim sunuyordu ve yasal metindeki
         vaat karşılıksızdı.

         Kişiselleştirmenin kapısı yalnızca burası değil; asıl karar
         `reklam.ts` içindeki `npa` bayrağında veriliyor:
         18 altına HER ZAMAN `npa: true` gider (kişiselleştirme yok),
         18 üstüne yalnızca UMP onayı varsa kişiselleştirme açılır.
         Bu izinler o kararın uygulanabilmesi için gereken teknik zemin.

         Play Console → Data safety formunda reklam kimliği toplandığı
         BEYAN EDİLMELİDİR (ayrıntı: PLAY_STORE_NOTLARI.md).
    -->

    <!-- Play Hizmetleri reklam kimliği -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <!-- Privacy Sandbox karşılıkları (Android 13+) -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" />
</manifest>
