<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Giriş dönüşü: com.zihinturu.app://giris -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.zihinturu.app" />
            </intent-filter>
        </activity>

        <!-- AdMob uygulama kimliği (gerçek kimlik, AdMob konsolundan).
             Uygulama kimliğinde tilde (~), reklam birimi kimliğinde
             eğik çizgi (/) bulunur; karıştırılırsa uygulama açılışta
             çöker. Banner birimi kimliği .env dosyasındadır. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6339500340265560~9019003216" />

        <!-- Reklam kimliği (AAID) izni kaldırılıyor.
             Çocuğa yönelik uygulamalarda reklam kimliği kullanılmaz;
             gizlilik metnindeki "davranışsal profil çıkarılmaz"
             taahhüdünün teknik karşılığı budur. -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bildirim izni (Android 13+). Kullanıcıya sorulur, reddedilebilir. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reklam takip izinleri AÇIKÇA KALDIRILIYOR.
         AdMob kütüphanesi bunları kendiliğinden ekler; çocuğa yönelik
         uygulamada hiçbiri kullanılmamalıdır. Gizlilik metnindeki
         "reklam kimliği toplanmaz, davranışsal profil çıkarılmaz"
         taahhüdünün teknik karşılığı budur.

         Kaldırılmazlarsa uygulama yine çalışır ama beyanımız yanlış
         olur; ayrıca Play Console'da "reklam kimliği kullanıyor musunuz"
         sorusuna evet demek zorunda kalırız. -->

    <!-- Eski (Play Hizmetleri) reklam kimliği -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Privacy Sandbox karşılıkları -->
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_TOPICS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
</manifest>
